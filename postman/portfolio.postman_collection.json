{
  "info": {
    "_postman_id": "cypress-qa-portfolio-collection",
    "name": "Cypress QA Portfolio — API Collection",
    "description": "Covers JSONPlaceholder REST endpoints to demonstrate API testing patterns.\n\nNote: Originally targeted ReqRes.in, which introduced mandatory paid API keys.\nSwitched to JSONPlaceholder — free, stable, no auth required.\n\nRun via: npm run api:newman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users — list all users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response is a non-empty array', () => {",
                  "  pm.expect(body).to.be.an('array').and.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('First user has required fields', () => {",
                  "  const user = body[0];",
                  "  pm.expect(user).to.have.all.keys('id','name','username','email','address','phone','website','company');",
                  "});",
                  "",
                  "pm.test('Email is a valid string', () => {",
                  "  pm.expect(body[0].email).to.be.a('string').and.include('@');",
                  "});",
                  "",
                  "// Store first user id for downstream requests",
                  "pm.environment.set('userId', body[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "GET /users/:id — single user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns correct user id', () => {",
                  "  pm.expect(body.id).to.equal(1);",
                  "});",
                  "",
                  "pm.test('Email is a valid string', () => {",
                  "  pm.expect(body.email).to.be.a('string').and.include('@');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          }
        },
        {
          "name": "GET /users/:id — 404 not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/9999",
              "host": ["{{baseUrl}}"],
              "path": ["users", "9999"]
            }
          }
        },
        {
          "name": "POST /users — create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains created resource', () => {",
                  "  pm.expect(body.name).to.equal('Nicolás Martínez');",
                  "  pm.expect(body.email).to.equal('nicomar9928@gmail.com');",
                  "  pm.expect(body.id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nicolás Martínez\",\n  \"username\": \"nicomar9928\",\n  \"email\": \"nicomar9928@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "PUT /users/:id — full update",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Updated fields are returned', () => {",
                  "  pm.expect(body.name).to.equal('Nicolás Martínez');",
                  "  pm.expect(body.id).to.equal(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"Nicolás Martínez\",\n  \"username\": \"nicomar9928\",\n  \"email\": \"nicomar9928@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          }
        },
        {
          "name": "DELETE /users/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET /posts — list all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response has 100 posts', () => {",
                  "  pm.expect(body).to.be.an('array').and.have.lengthOf(100);",
                  "});",
                  "",
                  "pm.test('First post has required fields', () => {",
                  "  const post = body[0];",
                  "  pm.expect(post).to.have.all.keys('userId','id','title','body');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "POST /posts — create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains the created post', () => {",
                  "  pm.expect(body.title).to.equal('Portfolio test post');",
                  "  pm.expect(body.userId).to.equal(1);",
                  "  pm.expect(body.id).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Portfolio test post\",\n  \"body\": \"Automated by Newman + Cypress\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        }
      ]
    }
  ]
}
